FROM python:3.10-slim-bookworm

ENV PIP_NO_CACHE_DIR=1 PYTHONUNBUFFERED=1
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates \
 && rm -rf /var/lib/apt/lists/*
WORKDIR /app
RUN python -m pip install --no-cache-dir --upgrade pip setuptools wheel

# PyTorch CPU index for torch/executorch, plus PyPI for everything else (e.g., numpy)
RUN PIP_INDEX_URL=https://download.pytorch.org/whl/cpu \
    PIP_EXTRA_INDEX_URL=https://pypi.org/simple \
    pip install --no-cache-dir --no-compile \
      torch==2.8.0 \
      executorch==0.7.0 \
      "numpy>=2.0,<2.3"

# copy your files (ensure filename matches your fallback import)
COPY model_min.py resnet18_def.py convert_entry.py ./

ENTRYPOINT ["python","-u","convert_entry.py"]
