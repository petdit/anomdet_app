# Dockerfile.exporter
FROM python:3.10-slim-bookworm

ENV PIP_NO_CACHE_DIR=1 PYTHONUNBUFFERED=1

# No image/vision libs needed now that we dropped torchvision
RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
 && rm -rf /var/lib/apt/lists/*

RUN python -m pip install --upgrade pip setuptools wheel

# Keep your exact versions; no torchvision here
# CPU-only for anything "torch"; PyPI for everything else — single layer
RUN PIP_INDEX_URL=https://download.pytorch.org/whl/cpu \
    PIP_EXTRA_INDEX_URL=https://pypi.org/simple \
    pip install --no-cache-dir --no-compile \
      torch \
      executorch==0.7.0 \
      "numpy>=2.0,<2.3" \
      google-cloud-storage

WORKDIR /app
# Include the vendored resnet + your model + exporter
COPY resnet18_def.py model_min.py export_to_pte.py ./

ENTRYPOINT ["python", "export_to_pte.py"]
